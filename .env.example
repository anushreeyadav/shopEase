# Copy to .env and replace every "change-me" value. Never commit .env or real secrets.
# Defaults below suit running services directly on the host (uvicorn). docker-compose.yml
# overrides the host names (MYSQL_HOST, *_SERVICE_URL) for the container network.

# --- Common -------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# --- Docker Compose host ports (all bound to 127.0.0.1; MySQL is not published) ----------
# Change one if the port is taken on your machine, e.g. PAYMENT_SERVICE_HOST_PORT=8015.
# GATEWAY_HOST_PORT=8000
# AUTH_SERVICE_HOST_PORT=8001
# USER_SERVICE_HOST_PORT=8002
# PRODUCT_SERVICE_HOST_PORT=8003
# ORDER_SERVICE_HOST_PORT=8004
# PAYMENT_SERVICE_HOST_PORT=8005

# --- MySQL (one server, five logical databases; docs/database_ownership.md) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Used only by the MySQL container and its init script, never by a service.
MYSQL_ROOT_PASSWORD=change-me
# Used only by scripts/init_local_databases.py on a MySQL you run yourself (not Docker).
# Prefer a dedicated admin account over root. Leave empty when using Docker Compose.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Each service gets a runtime user (DML on its own database only) and a migration user
# (DDL on its own database only). Services read only their own *_DB_* variables; the
# migration credentials are read only by Alembic (alembic -c services/<svc>/alembic.ini).
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=change-me
AUTH_DB_MIGRATION_USER=auth_migrator
AUTH_DB_MIGRATION_PASSWORD=change-me

USER_DB_NAME=user_db
USER_DB_USER=user_svc
USER_DB_PASSWORD=change-me
USER_DB_MIGRATION_USER=user_migrator
USER_DB_MIGRATION_PASSWORD=change-me

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_svc
PRODUCT_DB_PASSWORD=change-me
PRODUCT_DB_MIGRATION_USER=product_migrator
PRODUCT_DB_MIGRATION_PASSWORD=change-me

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=change-me
ORDER_DB_MIGRATION_USER=order_migrator
ORDER_DB_MIGRATION_PASSWORD=change-me

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_MIGRATION_USER=payment_migrator
PAYMENT_DB_MIGRATION_PASSWORD=change-me

# --- API Gateway --------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_URL=http://localhost:8003
ORDER_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
UPSTREAM_CONNECT_TIMEOUT_SECONDS=1.0
# Read timeouts: default (auth, users, products), orders, payments (docs/api_gateway.md §1).
UPSTREAM_TIMEOUT_SECONDS=5.0
ORDER_UPSTREAM_TIMEOUT_SECONDS=10.0
PAYMENT_UPSTREAM_TIMEOUT_SECONDS=20.0
MAX_REQUEST_BODY_BYTES=1048576
# Comma-separated browser origins; leave empty to keep CORS disabled.
CORS_ALLOWED_ORIGINS=

# --- Tokens (docs/security_model.md) -------------------------------------------------
# auth_service signs with an RSA private key: python scripts/generate_jwt_key.py
# Without one, development generates a temporary key (tokens die on restart); other
# environments refuse to start. Never commit the key (secrets/ and *.pem are git-ignored).
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_KEY_ID=shopease-1
JWT_ISSUER=shopease-auth
JWT_AUDIENCE=shopease-api
JWT_SERVICE_AUDIENCE=shopease-internal
JWT_ACCESS_TOKEN_MINUTES=15
JWT_SERVICE_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=14
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Everyone else verifies tokens with auth_service's public keys, cached for JWKS_CACHE_SECONDS.
JWKS_URL=http://localhost:8001/api/auth/.well-known/jwks.json
JWKS_CACHE_SECONDS=300

# --- Order Service -------------------------------------------------------------------------
# Service credentials from: python scripts/auth_cli.py create-service-client svc:order \
#   --scope products:read --scope inventory:reserve --scope addresses:read
ORDER_SERVICE_CLIENT_ID=svc:order
ORDER_SERVICE_CLIENT_SECRET=change-me
ORDER_CREATE_DEADLINE_SECONDS=7
# Recovery job: expire unpaid orders, clean up abandoned ones, retry stock releases; 0 disables.
ORDER_SWEEP_SECONDS=30
STUCK_PENDING_SECONDS=120

# --- Payment Service -----------------------------------------------------------------------
# MOCK provider only (development and tests; refused when APP_ENV=production).
PAYMENT_PROVIDER=mock
# Service credentials from: python scripts/auth_cli.py create-service-client svc:payment \
#   --scope orders:read --scope orders:payment
PAYMENT_SERVICE_CLIENT_ID=svc:payment
PAYMENT_SERVICE_CLIENT_SECRET=change-me
# Background job: reconcile unknown outcomes and retry result reports; 0 disables it.
PAYMENT_SWEEP_SECONDS=15

# --- Product Service stock reservations ---------------------------------------------
RESERVATION_TTL_MINUTES=15
# Expired-reservation sweep interval; 0 disables it.
RESERVATION_SWEEP_SECONDS=60

# --- Gateway rate limits (per client IP per minute; 0 disables) -----------------------
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=0
