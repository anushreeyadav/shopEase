# ShopEase Product Catalog Service - example settings. Safe to commit: it holds no real secrets.
#
# Copy to .env for local development:  Copy-Item .env.example .env
# Then replace every change-me value. The service refuses to start with a placeholder password.
# Generate each password with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# .env is git-ignored. Never commit it.

# --- Application -----------------------------------------------------------------------------
APP_NAME=ShopEase Product Catalog Service
APP_VERSION=1.0.0
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
DOCS_ENABLED=true

# --- Server ----------------------------------------------------------------------------------
# Used by "python -m app" and docker-compose.yml. 8000-8005 belong to the other ShopEase services
# (gateway, auth, user, product, order, payment) and are refused.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8006

# --- Database (MySQL 8). The MySQL container is also created from these values. ---------------
MYSQL_DATABASE=shopease_product_catalog_db
MYSQL_USER=catalog_svc
MYSQL_PASSWORD=change-me
# Host and port for Alembic, pytest or uvicorn running on this machine. MySQL is published on
# this port only with docker-compose.dev.yml. Inside Docker, the service uses catalog-mysql:3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
# Used only by the MySQL container.
MYSQL_ROOT_PASSWORD=change-me

# --- Authentication Service (shopease-auth-service) ------------------------------------------
# Every protected request's bearer token is checked here. This service holds no JWT secret.
AUTH_SERVICE_VERIFY_URL=http://127.0.0.1:8001/api/auth/verify-token
# Used instead by the container (docker-compose.yml), which cannot reach 127.0.0.1 on this machine.
DOCKER_AUTH_SERVICE_VERIFY_URL=http://host.docker.internal:8001/api/auth/verify-token
# Only with docker-compose.auth-network.yml (shared Docker network instead of host.docker.internal):
# AUTH_DOCKER_NETWORK=shopease-auth-service_default
# AUTH_DOCKER_VERIFY_URL=http://auth-service:8001/api/auth/verify-token
AUTH_SERVICE_TIMEOUT_SECONDS=5
# Must match JWT_ALGORITHM in shopease-auth-service (HS256, HS384 or HS512).
# Used only to reject malformed tokens before calling the Authentication Service.
JWT_ALGORITHM=HS256

# --- Inventory -------------------------------------------------------------------------------
# Active products whose stock_quantity is at or below this are reported as low on stock.
LOW_STOCK_THRESHOLD=5
