{
  "openapi": "3.1.0",
  "info": {
    "title": "ShopEase API Gateway",
    "description": "The single client-facing entry point. It routes `/api/auth`, `/api/users`, `/api/products`, `/api/categories`, `/api/orders` and `/api/payments` to the owning services with paths unchanged, authenticates access tokens at the edge, rate-limits credential endpoints, and never routes `/internal/*`. The proxied routes are documented in each service's own Swagger UI; the route map and verified endpoint list are in `docs/api_gateway.md`.\n\nAll errors use the ShopEase envelope (`ErrorResponse`). Every response carries `X-Request-ID`. Public routes (`/api/...`) are reached through the API Gateway on port 8000 with the same paths; `/internal/...` routes are for other services only. Use **Authorize** with an access token from `POST /api/auth/login`. Contracts: `docs/rest_api_notes.md`.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "The process is up and serving requests. Does not touch dependencies.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, in the standard ShopEase envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness check",
        "description": "Checks the service's own dependencies. Returns 503 if any of them is unavailable.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, in the standard ShopEase envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LivenessResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "version",
          "environment"
        ],
        "title": "LivenessResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable, machine-readable code",
            "examples": [
              "OUT_OF_STOCK"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "Human-readable; never contains internals",
            "examples": [
              "Not enough stock."
            ],
            "title": "Message",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Per-field problems, when relevant",
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlation ID, also in the X-Request-ID header",
            "examples": [
              "req-7f3a9c2e"
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "examples": [
              "body.items[0].quantity"
            ],
            "title": "Field",
            "type": "string"
          },
          "issue": {
            "examples": [
              "exceeds available stock (2)"
            ],
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "field",
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Every error produced by ShopEase uses this envelope (docs/rest_api_notes.md \u00a71.8).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User access token from POST /api/auth/login (`Authorization: Bearer <token>`)."
      },
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Internal service token from POST /internal/auth/service-token (client credentials). Internal routes are never reachable through the gateway."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Gateway liveness and upstream readiness"
    }
  ]
}
