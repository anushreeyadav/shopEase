          {
            "full_name": "Asha Rao",
            "phone": "+91-90000-00000"
          }
        ]
      },
      "ReadinessResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable, machine-readable code",
            "examples": [
              "OUT_OF_STOCK"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "Human-readable; never contains internals",
            "examples": [
              "Not enough stock."
            ],
            "title": "Message",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Per-field problems, when relevant",
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
