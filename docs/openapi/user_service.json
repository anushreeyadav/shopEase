  "components": {
    "schemas": {
      "AddressPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AddressRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AddressPage",
        "description": "Pagination envelope (rest_api_notes.md \u00a71.6)."
      },
      "AddressRead": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "line1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Line1"
          },
          "line2": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Postal Code"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default",
            "default": false
          },
          "address_id": {
            "type": "string",
            "format": "uuid",
            "title": "Address Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "line1",
          "city",
          "postal_code",
          "country",
          "address_id",
          "created_at",
          "updated_at"
        ],
        "title": "AddressRead"
      },
      "AddressWrite": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "line1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Line1"
          },
          "line2": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Postal Code"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line1",
          "city",
          "postal_code",
          "country"
        ],
        "title": "AddressWrite",
        "description": "Body for POST and PUT (PUT replaces the whole address).",
        "examples": [
          {
            "city": "Pune",
            "country": "IN",
            "is_default": true,
            "label": "Home",
            "line1": "12 Example Street",
            "line2": "Flat 4B",
            "postal_code": "411001",
            "state": "Maharashtra"
          }
        ]
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
