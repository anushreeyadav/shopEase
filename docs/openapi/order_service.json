            "title": "Currency"
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status",
          "payment_status",
          "total_amount",
          "currency",
          "item_count",
          "created_at"
        ],
        "title": "OrderSummary"
      },
      "Page_OrderSummary_": {
        "properties": {
