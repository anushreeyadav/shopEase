        "type": "object",
        "required": [
          "items",
          "shipping_address_id"
        ],
        "title": "OrderCreate",
        "description": "Prices and totals are never accepted from the client (extra fields are rejected).",
        "examples": [
          {
            "items": [
              {
                "product_id": "9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c61",
                "quantity": 1
              }
            ],
            "shipping_address_id": "7a1e4b2c-5d6f-4a8b-9c0d-2e3f4a5b6c71"
          }
        ]
      },
      "OrderItemCreate": {
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemCreate"
      },
      "OrderItemRead": {
        "properties": {
