# Copy to .env for local development:  Copy-Item .env.example .env
# Then replace every change-me value. The service refuses to start with a placeholder password.
# Generate each password with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_NAME=ShopEase User Service
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
DOCS_ENABLED=true

# Database. The MySQL container is also created from these values.
MYSQL_DATABASE=shopease_user_db
MYSQL_USER=user_svc
MYSQL_PASSWORD=change-me
# Host and port for Alembic, pytest or uvicorn running on this machine. MySQL is published on
# this port only with docker-compose.dev.yml. Inside Docker, the service always uses user-mysql:3306.
# 3309 avoids the Authentication Service's database on 3308.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3309
# Used only by the MySQL container.
MYSQL_ROOT_PASSWORD=change-me

# Authentication Service. Every request's bearer token is sent here to be checked.
# For uvicorn on this machine, with the Authentication Service on port 8001:
AUTH_SERVICE_VERIFY_URL=http://127.0.0.1:8001/api/auth/verify-token
# For the user-service container (docker-compose.yml), which cannot use 127.0.0.1. The
# Authentication Service is a separate Compose project, so its service name does not resolve here;
# host.docker.internal reaches the port it publishes on this machine (Docker Desktop).
DOCKER_AUTH_SERVICE_VERIFY_URL=http://host.docker.internal:8001/api/auth/verify-token
AUTH_SERVICE_TIMEOUT_SECONDS=5

# Port on this machine for the containerised service (docker-compose.yml).
USER_SERVICE_HOST_PORT=8002
