{
  "info": {
    "name": "ShopEase User Service",
    "description": "Every User Service endpoint (port 8002), with login on the Authentication Service (port 8001).\n\nRun the folders in order (Collection Runner, or one request at a time). 'Register' creates a new test user with a generated email and password; 'Login' stores its access token in the `token` collection variable, which every User Service request sends as `Authorization: Bearer`.\n\nNever export or share the collection after a run without clearing `token` and `password`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "userBaseUrl",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "authBaseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "secondAddressId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Health",
      "item": [
        {
          "name": "Service health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Database health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/health/db",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1 Authentication Service (8001)",
      "item": [
        {
          "name": "Register test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"email\")) {",
                  "  pm.collectionVariables.set(\"email\", `postman.${Date.now()}@example.com`);",
                  "}",
                  "if (!pm.collectionVariables.get(\"password\")) {",
                  "  pm.collectionVariables.set(\"password\", \"Pm!\" + Math.random().toString(36).slice(2) + Date.now() + \"a\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authBaseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Customer\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirm_password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authBaseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Verify token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"valid\", () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{authBaseUrl}}/api/auth/verify-token"
          }
        }
      ]
    },
    {
      "name": "2 Authentication failures",
      "item": [
        {
          "name": "No token: 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/profile",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3 Profile",
      "item": [
        {
          "name": "Create profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Customer\",\n  \"phone_number\": \"+91 98765 43210\",\n  \"gender\": \"FEMALE\"\n}"
            }
          }
        },
        {
          "name": "Create profile again: 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Customer\"\n}"
            }
          }
        },
        {
          "name": "Client-supplied auth_user_id: 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Customer\",\n  \"auth_user_id\": 1\n}"
            }
          }
        },
        {
          "name": "Get profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/profile"
          }
        },
        {
          "name": "Replace profile (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Customer\",\n  \"phone_number\": \"+91 98765 43210\",\n  \"date_of_birth\": \"1995-04-12\",\n  \"gender\": \"FEMALE\"\n}"
            }
          }
        },
        {
          "name": "Update profile (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gender\": \"PREFER_NOT_TO_SAY\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4 Account",
      "item": [
        {
          "name": "Get account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"profile ACTIVE\", () => pm.expect(pm.response.json().profile_status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/account"
          }
        },
        {
          "name": "Update contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/account/contact",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+91 91234 56789\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5 Addresses",
      "item": [
        {
          "name": "Create first address (becomes default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"addressId\", pm.response.json().id);",
                  "pm.test(\"is default\", () => pm.expect(pm.response.json().is_default).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/addresses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"HOME\",\n  \"full_name\": \"Postman Customer\",\n  \"phone_number\": \"+91 98765 43210\",\n  \"address_line_1\": \"12 MG Road\",\n  \"address_line_2\": \"Flat 4B\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"postal_code\": \"560001\"\n}"
            }
          }
        },
        {
          "name": "Create second address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"secondAddressId\", pm.response.json().id);",
                  "pm.test(\"not default\", () => pm.expect(pm.response.json().is_default).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/addresses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"OFFICE\",\n  \"full_name\": \"Postman Customer\",\n  \"phone_number\": \"+91 98765 43210\",\n  \"address_line_1\": \"1 Tech Park\",\n  \"address_line_2\": null,\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"postal_code\": \"560001\"\n}"
            }
          }
        },
        {
          "name": "List addresses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exactly one default\", () => pm.expect(pm.response.json().filter(a => a.is_default).length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses"
          }
        },
        {
          "name": "Get address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/{{addressId}}"
          }
        },
        {
          "name": "Replace address (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userBaseUrl}}/api/users/addresses/{{addressId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"HOME\",\n  \"full_name\": \"Postman Customer\",\n  \"phone_number\": \"+91 98765 43210\",\n  \"address_line_1\": \"14 MG Road\",\n  \"address_line_2\": \"Flat 4B\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"postal_code\": \"560001\"\n}"
            }
          }
        },
        {
          "name": "Set second address as default",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is default\", () => pm.expect(pm.response.json().is_default).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/{{secondAddressId}}/default"
          }
        },
        {
          "name": "Get default address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"second address\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"secondAddressId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/default"
          }
        },
        {
          "name": "Delete the default address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/{{secondAddressId}}"
          }
        },
        {
          "name": "Default promoted to the remaining address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"first address\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"addressId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/default"
          }
        },
        {
          "name": "Deleted address: 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses/{{secondAddressId}}"
          }
        }
      ]
    },
    {
      "name": "6 Deactivation (run last)",
      "item": [
        {
          "name": "Deactivate account (local profile only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"auth account unchanged\", () => pm.expect(pm.response.json().authentication_account_changed).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/account/deactivate"
          }
        },
        {
          "name": "Profile after deactivation: 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/profile"
          }
        },
        {
          "name": "Addresses after deactivation: 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userBaseUrl}}/api/users/addresses"
          }
        },
        {
          "name": "Login still works on the Authentication Service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authBaseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
